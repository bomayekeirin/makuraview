---
import { url } from "../lib/url";
import CatHeader from "./CatHeader.astro";
import ShopCard from "./ShopCard.astro";
import { shopsIn, subGroups, isOpenToday, WEEKDAY_JA, todayKey } from "../data/shops";
import { byId, type CategoryId } from "../data/categories";

interface Props {
  category: CategoryId;
  intro?: string;
}
const { category, intro } = Astro.props;

const cat = byId(category)!;
const shops = shopsIn(category);
const groups = subGroups(category);
const openNow = shops.filter((s) => isOpenToday(s));
const today = WEEKDAY_JA[todayKey()];
const irregularCount = shops.filter((s) => s.irregular).length;
---

<CatHeader current={category} />

<main>
  <section class="today wrap">
    <div class="today-main">
      <p class="today-label">きょう（{today}）</p>
      <p class="today-body">
        <strong class="today-num">{openNow.length}</strong>
        <span class="today-unit">軒が営業日</span>
      </p>
      <p class="today-of">掲載 {shops.length} 軒中</p>
    </div>
    {intro && <p class="today-intro">{intro}</p>}
    {irregularCount > 0 && (
      <p class="today-caveat">
        定休日をもとにした目安です。
        <strong>{irregularCount}軒</strong>は臨時休業もあるため、行く前に確認を。
      </p>
    )}
  </section>

  <div class="tools wrap">
    <div class="chips" role="group" aria-label="種類でしぼる">
      <button class="chip is-on" data-sub="all" type="button">
        すべて<span class="chip-n">{shops.length}</span>
      </button>
      {groups.map((g) => (
        <button class="chip" data-sub={g.key} type="button">
          {g.label}<span class="chip-n">{g.count}</span>
        </button>
      ))}
    </div>

    <label class="toggle">
      <input type="checkbox" id="open-only" />
      <span class="toggle-box" aria-hidden="true"></span>
      <span class="toggle-txt">今日の営業日だけ</span>
    </label>
  </div>

  <p class="count wrap" id="count" aria-live="polite"></p>

  <section class="list wrap" id="list">
    {shops.map((s) => (
      <div class="cell" data-sub={s.sub} data-open={isOpenToday(s) ? "1" : "0"}>
        <ShopCard shop={s} />
      </div>
    ))}
  </section>

  <p class="empty wrap" id="empty" hidden>
    条件に合うお店がありません。<button class="reset" type="button" id="reset">条件をもどす</button>
  </p>

  <section class="wrap ask">
    <h2>載っていないお店があります</h2>
    <p>
      枕崎の{cat.label}は、まだ全部載せきれていません。<br />
      知っているお店を教えてください。掲載は無料です。
    </p>
    <a class="ask-btn" href={url("/entry/")}>お店を教える</a>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-in">
    <p class="foot-logo">まくらびゅ</p>
    <p class="foot-sub">枕崎市網羅型ポータルサイト</p>
    <a class="foot-home" href={url("/")}>ほかのカテゴリを見る</a>
  </div>
</footer>

<style>
  main { padding-bottom: var(--s-16); }

  .today {
    margin-top: var(--s-8);
    padding: var(--s-6);
    border-radius: var(--r-md);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 9%, #fff) 0%,
      var(--paper-warm) 100%
    );
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .today-main {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .today-label {
    font-family: var(--font-data);
    font-weight: 500;
    font-size: var(--t-xs);
    letter-spacing: 0.24em;
    color: var(--accent);
    width: 100%;
  }
  .today-num {
    font-family: var(--font-data);
    font-weight: 500;
    font-size: clamp(2.6rem, 10vw, var(--t-2xl));
    line-height: 1;
    color: var(--accent);
  }
  .today-unit {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-md);
  }
  .today-of {
    font-size: var(--t-sm);
    color: var(--ink-mid);
    margin-left: auto;
  }
  .today-intro {
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    line-height: 1.9;
    color: var(--ink);
    max-width: 42em;
  }
  .today-caveat {
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    font-size: var(--t-xs);
    color: var(--ink-mid);
    line-height: 1.7;
  }

  .tools {
    margin-top: var(--s-8);
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    align-items: center;
  }
  .chips { display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-4);
    border-radius: var(--r-full);
    border: 1px solid rgba(20, 35, 43, 0.16);
    font-size: var(--t-sm);
    font-weight: var(--w-body);
    background: #fff;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease),
                background 0.2s var(--ease);
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .chip-n { font-family: var(--font-data); font-weight: 500; font-size: 0.78em; opacity: 0.72; }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    cursor: pointer;
    font-size: var(--t-sm);
    margin-left: auto;
    user-select: none;
  }
  .toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
  .toggle-box {
    width: 44px; height: 26px;
    border-radius: var(--r-full);
    background: rgba(20, 35, 43, 0.16);
    position: relative;
    transition: background 0.25s var(--ease);
    flex: none;
  }
  .toggle-box::after {
    content: "";
    position: absolute;
    top: 3px; left: 3px;
    width: 20px; height: 20px;
    border-radius: var(--r-full);
    background: #fff;
    transition: transform 0.25s var(--ease);
  }
  .toggle input:checked + .toggle-box { background: var(--accent); }
  .toggle input:checked + .toggle-box::after { transform: translateX(18px); }
  .toggle input:focus-visible + .toggle-box {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .count {
    margin-top: var(--s-4);
    font-family: var(--font-data);
    font-weight: 500;
    font-size: var(--t-xs);
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }

  .list {
    margin-top: var(--s-3);
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  }
  .cell { display: contents; }
  .cell[hidden] { display: none; }

  .empty {
    margin-top: var(--s-12);
    text-align: center;
    color: var(--ink-mid);
    font-size: var(--t-sm);
  }
  .reset {
    margin-left: var(--s-2);
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
  }

  .ask {
    margin-top: var(--s-16);
    padding: var(--s-8);
    border-radius: var(--r-md);
    border: 2px dashed color-mix(in srgb, var(--accent) 34%, transparent);
    text-align: center;
  }
  .ask h2 { font-size: var(--t-md); }
  .ask p {
    margin-top: var(--s-3);
    color: var(--ink-mid);
    font-size: var(--t-sm);
    line-height: 1.9;
  }
  .ask-btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-top: var(--s-4);
    padding: 0 var(--s-8);
    border-radius: var(--r-full);
    background: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .ask-btn:hover { filter: brightness(1.1); }

  .foot {
    background: var(--sea-deep);
    color: var(--foam);
    padding: var(--s-12) 0;
  }
  .foot-in { text-align: center; }
  .foot-logo { font-family: var(--font-display); font-weight: 900; font-size: var(--t-md); }
  .foot-sub {
    margin-top: var(--s-1);
    font-size: var(--t-xs);
    opacity: 0.5;
    letter-spacing: 0.18em;
  }
  .foot-home {
    display: inline-block;
    margin-top: var(--s-6);
    padding: var(--s-3) var(--s-6);
    border: 1px solid rgba(237, 243, 241, 0.3);
    border-radius: var(--r-full);
    font-size: var(--t-sm);
    transition: background 0.2s var(--ease);
  }
  .foot-home:hover { background: rgba(237, 243, 241, 0.1); }

  @media (max-width: 560px) {
    .toggle { margin-left: 0; }
  }
</style>

<script>
  const cells = Array.from(document.querySelectorAll<HTMLElement>(".cell"));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip"));
  const openOnly = document.getElementById("open-only") as HTMLInputElement;
  const countEl = document.getElementById("count")!;
  const emptyEl = document.getElementById("empty")!;
  const resetBtn = document.getElementById("reset");

  let sub = "all";

  function apply() {
    let n = 0;
    for (const c of cells) {
      const okSub = sub === "all" || c.dataset.sub === sub;
      const okOpen = !openOnly.checked || c.dataset.open === "1";
      const show = okSub && okOpen;
      c.hidden = !show;
      if (show) n++;
    }
    countEl.textContent = `${n} 軒を表示中`;
    emptyEl.hidden = n > 0;
  }

  chips.forEach((c) => {
    c.addEventListener("click", () => {
      chips.forEach((x) => x.classList.toggle("is-on", x === c));
      sub = c.dataset.sub!;
      apply();
    });
  });

  openOnly.addEventListener("change", apply);

  resetBtn?.addEventListener("click", () => {
    sub = "all";
    openOnly.checked = false;
    chips.forEach((x) => x.classList.toggle("is-on", x.dataset.sub === "all"));
    apply();
  });

  apply();
</script>
