---
import { url } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import CatHeader from "../../components/CatHeader.astro";
import { SHOPS, WEEKDAY_JA, isOpenToday, neighborsOf } from "../../data/shops";
import { byId } from "../../data/categories";

export function getStaticPaths() {
  return SHOPS.map((shop) => ({ params: { slug: shop.slug }, props: { shop } }));
}

const { shop } = Astro.props;
const cat = byId(shop.primary)!;
const open = isOpenToday(shop);
const closedText = shop.closed.length
  ? shop.closed.map((d) => WEEKDAY_JA[d]).join("・")
  : "なし";
const mapQuery = encodeURIComponent(`枕崎市${shop.address} ${shop.name}`);
const neighbors = neighborsOf(shop);
---

<Base
  title={`${shop.name} ─ まくらびゅ｜枕崎市網羅型ポータルサイト`}
  description={shop.lead ?? `枕崎市${shop.address}の${shop.subLabel}。`}
  category={shop.primary}
>
  <CatHeader current={shop.primary} />

  <main class="wrap">
    <nav class="crumb" aria-label="現在地">
      <a href={url(`/${shop.primary}/`)}>{cat.label}</a>
      <span aria-hidden="true">›</span>
      <span>{shop.subLabel}</span>
    </nav>

    <header class="hero">
      <p class="eyebrow">{shop.subLabel}</p>
      <h1>{shop.name}</h1>
      <p class="kana">{shop.kana}</p>
      {shop.lead && <p class="lead">{shop.lead}</p>}

      {shop.categories.length > 1 && (
        <p class="also">
          このお店は
          {shop.categories.map((c) => {
            const x = byId(c)!;
            return <a class="also-link" href={url(`/${c}/`)} style={`--c:${x.color}`}>{x.label}</a>;
          })}
          に載っています
        </p>
      )}
    </header>

    {shop.charge && (
      <section class="charge">
        <p class="charge-label">料金</p>
        <p class="charge-val">{shop.charge}</p>
        <p class="charge-note">掲載時点の情報です。お店で確認してください。</p>
      </section>
    )}

    {shop.signature && (
      <section class="sig">
        <p class="sig-label">名物</p>
        <p class="sig-item">{shop.signature.item}</p>
        {shop.signature.price && <p class="sig-price">{shop.signature.price}</p>}
      </section>
    )}

    {shop.irregular && (
      <p class="warn">
        <span class="warn-mark" aria-hidden="true">!</span>
        この店は定休日以外にも休むことがあります。行く前に確認してください。
      </p>
    )}

    <section class="facts">
      <div class="fact">
        <p class="fact-key">きょう</p>
        <p class:list={["fact-val", open ? "ok" : "ng"]}>
          {open ? "営業日です" : "定休日です"}
        </p>
      </div>
      <div class="fact">
        <p class="fact-key">営業時間</p>
        <p class="fact-val num">{shop.hours ?? "確認中"}</p>
      </div>
      <div class="fact">
        <p class="fact-key">定休日</p>
        <p class="fact-val">{closedText}</p>
      </div>
      <div class="fact">
        <p class="fact-key">住所</p>
        <p class="fact-val">枕崎市{shop.address}</p>
      </div>
    </section>

    {(shop.reservation || shop.payment || shop.delivery || shop.dietary) && (
      <section class="notes">
        {shop.reservation && (
          <div class="note">
            <p class="note-key">予約</p>
            <p class="note-val">{shop.reservation}</p>
          </div>
        )}
        {shop.payment && (
          <div class="note">
            <p class="note-key">支払い</p>
            <p class="note-val">{shop.payment}</p>
          </div>
        )}
        {shop.delivery && (
          <div class="note">
            <p class="note-key">配達</p>
            <p class="note-val">{shop.delivery}</p>
          </div>
        )}
        {shop.dietary && (
          <div class="note">
            <p class="note-key">食事制限</p>
            <p class="note-val">{shop.dietary}</p>
          </div>
        )}
      </section>
    )}

    <section class="acts">
      {shop.tel && (
        <a class="act act-primary" href={`tel:${shop.tel.replace(/-/g, "")}`}
           data-track="tap_tel" data-shop={shop.slug}>
          <span class="act-ico" aria-hidden="true">☎</span>
          <span class="act-txt">電話する<span class="act-sub num">{shop.tel}</span></span>
        </a>
      )}
      <a class="act" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
         target="_blank" rel="noopener"
         data-track="tap_map" data-shop={shop.slug}>
        <span class="act-ico" aria-hidden="true">◎</span>
        <span class="act-txt">地図で見る<span class="act-sub">ルート案内</span></span>
      </a>
      {shop.instagram && (
        <a class="act" href={`https://instagram.com/${shop.instagram}`}
           target="_blank" rel="noopener"
           data-track="tap_instagram" data-shop={shop.slug}>
          <span class="act-ico" aria-hidden="true">◍</span>
          <span class="act-txt">Instagram<span class="act-sub">@{shop.instagram}</span></span>
        </a>
      )}
      {shop.x && (
        <a class="act" href={`https://x.com/${shop.x}`}
           target="_blank" rel="noopener"
           data-track="tap_x" data-shop={shop.slug}>
          <span class="act-ico" aria-hidden="true">✕</span>
          <span class="act-txt">X（旧Twitter）<span class="act-sub">@{shop.x}</span></span>
        </a>
      )}
    </section>

    {neighbors.length > 0 && (
      <section class="nb">
        <p class="nb-label">同じ建物に、あと{neighbors.length}軒</p>
        <p class="nb-bld">{shop.building}</p>
        <div class="nb-grid">
          {neighbors.map((n) => (
            <a class="nb-card" href={url(`/shop/${n.slug}/`)}>
              <span class="nb-name">{n.name}</span>
              <span class="nb-sub">{n.subLabel}</span>
              {n.charge && <span class="nb-charge">{n.charge}</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    {shop.operator && (
      <p class="op">同じ方が「{shop.operator}」を営んでいます。</p>
    )}

    <section class="fix">
      <p>
        情報が違っていたら教えてください。すぐ直します。
        <a href={url("/contact/")}>まちがいを教える</a>
      </p>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <a class="back" href={url(`/${shop.primary}/`)}>← {cat.label}の一覧へ</a>
      <a class="back" href={url("/")}>ほかのカテゴリを見る</a>
    </div>
  </footer>
</Base>

<style>
  main { padding: var(--s-6) 0 var(--s-16); }

  .crumb {
    display: flex; align-items: center; gap: var(--s-2);
    font-size: var(--t-xs); color: var(--ink-faint);
  }
  .crumb a { color: var(--accent); }

  .hero { margin-top: var(--s-6); }
  .hero h1 { margin-top: var(--s-2); font-size: clamp(1.9rem, 7vw, var(--t-xl)); }
